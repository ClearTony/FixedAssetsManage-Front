{"ast":null,"code":"export default {\n  assetsName: \"StaffAssets\",\n  data() {\n    return {\n      tableData: [],\n      // 所有的数据\n      pageNum: 1,\n      // 当前的页码\n      pageSize: 10,\n      // 每页显示的个数\n      total: 0,\n      assetsName: null,\n      fromVisible: false,\n      form: {},\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      rules: {},\n      ids: []\n    };\n  },\n  created() {\n    this.load(1);\n  },\n  methods: {\n    saveRepair() {\n      // 保存按钮触发的逻辑  它会触发新增或者更新\n      this.$request({\n        url: '/assetsRepair/add',\n        method: 'POST',\n        data: this.form\n      }).then(res => {\n        if (res.code === '200') {\n          // 表示成功保存\n          this.$message.success('保存成功');\n          this.load(1);\n          this.fromVisible = false;\n        } else {\n          this.$message.error(res.msg); // 弹出错误的信息\n        }\n      });\n    },\n\n    handleRepair(row) {\n      this.form = {\n        receiveId: row.id\n      };\n      this.fromVisible = true;\n    },\n    changeStatus(row, returnStatus) {\n      this.form = JSON.parse(JSON.stringify(row));\n      this.form.returnStatus = returnStatus;\n      this.$confirm('您确定归还资产吗？', '确认归还', {\n        type: \"warning\"\n      }).then(response => {\n        this.$request.put('/assetsReceive/update', this.form).then(res => {\n          if (res.code === '200') {\n            this.$message.success('归还成功');\n            this.load(1);\n          } else {\n            this.$message.error(res.msg); // 弹出错误的信息\n          }\n        });\n      }).catch(e => {});\n    },\n    load(pageNum) {\n      // 分页查询\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/assetsReceive/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          assetsName: this.assetsName,\n          status: '通过',\n          returnStatus: '未归还'\n        }\n      }).then(res => {\n        if (res.code === '200') {\n          this.tableData = res.data?.list;\n          this.total = res.data?.total;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    reset() {\n      this.assetsName = null;\n      this.load(1);\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    }\n  }\n};","map":{"version":3,"names":["assetsName","data","tableData","pageNum","pageSize","total","fromVisible","form","user","JSON","parse","localStorage","getItem","rules","ids","created","load","methods","saveRepair","$request","url","method","then","res","code","$message","success","error","msg","handleRepair","row","receiveId","id","changeStatus","returnStatus","stringify","$confirm","type","response","put","catch","e","get","params","status","list","reset","handleCurrentChange"],"sources":["src/views/manager/StaffAssets.vue"],"sourcesContent":["<template>\n  <div>\n    <div class=\"search\">\n      <el-input placeholder=\"请输入资产名称查询\" style=\"width: 200px\" v-model=\"assetsName\"></el-input>\n      <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"load(1)\">查询</el-button>\n      <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">重置</el-button>\n    </div>\n\n    <div class=\"table\">\n      <el-table :data=\"tableData\" strip @selection-change=\"handleSelectionChange\">\n        <el-table-column prop=\"id\" label=\"ID\" width=\"70\" align=\"center\" sortable></el-table-column>\n        <el-table-column prop=\"assetsName\" label=\"资产名称\"></el-table-column>\n        <el-table-column prop=\"assetsNo\" label=\"资产编号\"></el-table-column>\n        <el-table-column prop=\"staffName\" label=\"员工名称\"></el-table-column>\n        <el-table-column prop=\"date\" label=\"领用时间\"></el-table-column>\n        <el-table-column prop=\"returnDate\" label=\"归还日期\">\n          <template v-slot=\"scope\">\n            <strong style=\"color: red\" v-if=\"(scope.row.returnStatus === '未归还')  &&\n             (new Date(scope.row.returnDate).getTime() < new Date().getTime())\">{{scope.row.returnDate}}</strong>\n            <span v-else>{{scope.row.returnDate}}</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"returnStatus\" label=\"归还状态\">\n          <template v-slot=\"scope\">\n            <span style=\"color: #000\" v-if=\"scope.row.returnStatus === '未归还'\">未归还</span>\n            <span style=\"color: #049f58\" v-if=\"scope.row.returnStatus === '已归还'\">已归还</span>\n          </template>\n        </el-table-column>\n\n        <el-table-column label=\"操作\" align=\"center\" width=\"160\">\n          <template v-slot=\"scope\">\n            <el-button size=\"mini\" type=\"primary\" plain @click=\"changeStatus(scope.row,'已归还')\">归还</el-button>\n            <el-button size=\"mini\" type=\"warning\" plain @click=\"handleRepair(scope.row)\">维修</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <div class=\"pagination\">\n        <el-pagination\n            background\n            @current-change=\"handleCurrentChange\"\n            :current-page=\"pageNum\"\n            :page-sizes=\"[5, 10, 20]\"\n            :page-size=\"pageSize\"\n            layout=\"total, prev, pager, next\"\n            :total=\"total\">\n        </el-pagination>\n      </div>\n    </div>\n\n    <el-dialog title=\"资产报修\" :visible.sync=\"fromVisible\" width=\"40%\" :close-on-click-modal=\"false\" destroy-on-close>\n      <el-form :model=\"form\" label-width=\"100px\" style=\"padding-right: 50px\" :rules=\"rules\" ref=\"formRef\">\n        <el-form-item label=\"报修理由\" prop=\"reason\">\n          <el-input type=\"textarea\" :rows=\"5\" v-model=\"form.reason\" placeholder=\"报修理由\"></el-input>\n        </el-form-item>\n      </el-form>\n        <div slot=\"footer\" class=\"dialog-footer\">\n          <el-button @click=\"fromVisible = false\">取 消</el-button>\n          <el-button type=\"primary\" @click=\"saveRepair\">确 定</el-button>\n        </div>\n      </el-dialog>\n\n  </div>\n</template>\n<script>\n\n\nexport default {\n  assetsName: \"StaffAssets\",\n  data() {\n    return {\n      tableData: [],  // 所有的数据\n      pageNum: 1,   // 当前的页码\n      pageSize: 10,  // 每页显示的个数\n      total: 0,\n      assetsName: null,\n      fromVisible: false,\n      form: {},\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      rules: {\n      },\n      ids: []\n    }\n  },\n  created() {\n    this.load(1)\n  },\n  methods: {\n    saveRepair() {   // 保存按钮触发的逻辑  它会触发新增或者更新\n      this.$request({\n        url: '/assetsRepair/add',\n        method: 'POST',\n        data: this.form\n      }).then(res => {\n        if (res.code === '200') {  // 表示成功保存\n          this.$message.success('保存成功')\n          this.load(1)\n          this.fromVisible = false\n        } else {\n          this.$message.error(res.msg)  // 弹出错误的信息\n        }\n      })\n    },\n    handleRepair(row){\n      this.form={ receiveId: row.id}\n      this.fromVisible=true\n    },\n    changeStatus(row, returnStatus) {\n      this.form = JSON.parse(JSON.stringify(row))\n      this.form.returnStatus = returnStatus\n      this.$confirm('您确定归还资产吗？', '确认归还', {type: \"warning\"}).then(response => {\n        this.$request.put('/assetsReceive/update', this.form).then(res => {\n          if (res.code === '200') {\n            this.$message.success('归还成功')\n            this.load(1)\n          } else {\n            this.$message.error(res.msg)  // 弹出错误的信息\n          }\n        })\n      }).catch(e => {})\n    },\n    load(pageNum) {  // 分页查询\n      if (pageNum) this.pageNum = pageNum\n      this.$request.get('/assetsReceive/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          assetsName: this.assetsName,\n          status:'通过',\n          returnStatus:'未归还',\n        }\n      }).then(res => {\n        if (res.code === '200') {\n          this.tableData = res.data?.list\n          this.total = res.data?.total\n        } else {\n          this.$message.error(res.msg)\n        }\n      })\n    },\n    reset() {\n      this.assetsName = null\n      this.load(1)\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum)\n    },\n  }\n}\n</script>\n\n<style scoped>\n\n</style>"],"mappings":"AAkEA;EACAA,UAAA;EACAC,KAAA;IACA;MACAC,SAAA;MAAA;MACAC,OAAA;MAAA;MACAC,QAAA;MAAA;MACAC,KAAA;MACAL,UAAA;MACAM,WAAA;MACAC,IAAA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,KAAA,GACA;MACAC,GAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAC,WAAA;MAAA;MACA,KAAAC,QAAA;QACAC,GAAA;QACAC,MAAA;QACApB,IAAA,OAAAM;MACA,GAAAe,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAV,IAAA;UACA,KAAAV,WAAA;QACA;UACA,KAAAmB,QAAA,CAAAE,KAAA,CAAAJ,GAAA,CAAAK,GAAA;QACA;MACA;IACA;;IACAC,aAAAC,GAAA;MACA,KAAAvB,IAAA;QAAAwB,SAAA,EAAAD,GAAA,CAAAE;MAAA;MACA,KAAA1B,WAAA;IACA;IACA2B,aAAAH,GAAA,EAAAI,YAAA;MACA,KAAA3B,IAAA,GAAAE,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAA0B,SAAA,CAAAL,GAAA;MACA,KAAAvB,IAAA,CAAA2B,YAAA,GAAAA,YAAA;MACA,KAAAE,QAAA;QAAAC,IAAA;MAAA,GAAAf,IAAA,CAAAgB,QAAA;QACA,KAAAnB,QAAA,CAAAoB,GAAA,+BAAAhC,IAAA,EAAAe,IAAA,CAAAC,GAAA;UACA,IAAAA,GAAA,CAAAC,IAAA;YACA,KAAAC,QAAA,CAAAC,OAAA;YACA,KAAAV,IAAA;UACA;YACA,KAAAS,QAAA,CAAAE,KAAA,CAAAJ,GAAA,CAAAK,GAAA;UACA;QACA;MACA,GAAAY,KAAA,CAAAC,CAAA;IACA;IACAzB,KAAAb,OAAA;MAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAgB,QAAA,CAAAuB,GAAA;QACAC,MAAA;UACAxC,OAAA,OAAAA,OAAA;UACAC,QAAA,OAAAA,QAAA;UACAJ,UAAA,OAAAA,UAAA;UACA4C,MAAA;UACAV,YAAA;QACA;MACA,GAAAZ,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAtB,SAAA,GAAAqB,GAAA,CAAAtB,IAAA,EAAA4C,IAAA;UACA,KAAAxC,KAAA,GAAAkB,GAAA,CAAAtB,IAAA,EAAAI,KAAA;QACA;UACA,KAAAoB,QAAA,CAAAE,KAAA,CAAAJ,GAAA,CAAAK,GAAA;QACA;MACA;IACA;IACAkB,MAAA;MACA,KAAA9C,UAAA;MACA,KAAAgB,IAAA;IACA;IACA+B,oBAAA5C,OAAA;MACA,KAAAa,IAAA,CAAAb,OAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}